    "MemDoping turns science-based memory techniques into short, playful missions. This build is an early prototype using clearly-labeled sample content." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "MemDoping turns science-based memory techniques into short, playful missions. This build is an early prototype using clearly-labeled sample content." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "MemDoping, bilime dayalı hafıza tekniklerini kısa, oyunsu görevlere dönüştürür. Bu sürüm, açıkça etiketlenmiş örnek içerik kullanan erken bir prototiptir." } }
      }
    },
    "MemDoping XP" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "MemDoping XP" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "MemDoping XP" } }
      }
    },
    "Missed one? That's the technique working. Recalling — and correcting — is how the link gets stronger." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Missed one? That's the technique working. Recalling — and correcting — is how the link gets stronger." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Birini mi kaçırdın? Bu, tekniğin işe yaradığının kanıtı. Hatırlamak — ve düzeltmek — bağlantıyı güçlendirir." } }
      }
    },
