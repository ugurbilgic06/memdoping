                int[] primvars:st:indices = [0, 3, 8, 6, 6, 8, 12, 10, 10, 12, 16, 14, 14, 16, 20, 18, 18, 20, 24, 22, 22, 24, 28, 26, 26, 28, 32, 30, 30, 32, 37, 34, 9, 4, 40, 36, 33, 29, 25, 21, 17, 13, 34, 37, 41, 38, 38, 41, 5, 1, 2, 7, 11, 15, 19, 23, 27, 31, 35, 39]
                uniform token subdivisionScheme = "none"
                custom string userProperties:blender:data_name = "Cylinder.001"
            }
        }
    }

    def DomeLight "env_light" (
        prepend apiSchemas = ["ColorSpaceAPI"]
    )
    {
        uniform token colorSpace:name = "lin_rec709_scene"
        float inputs:intensity = 1
        asset inputs:texture:file = @./textures/color_0C0C0C.exr@
    }
}

